{
  "reports": {
    ".read": "auth != null",
    ".indexOn": [
      "created_at",
      "owner_id"
    ],
    "$id": {
      ".write": "auth != null && ((!data.exists() && newData.child('owner_id').val() === auth.uid) || data.child('owner_id').val() === auth.uid) && (newData.exists() || (root.child('clothingKeeper').child('intakes').child(auth.uid).child($id).child('status').val() !== 'queued' && root.child('clothingKeeper').child('intakes').child(auth.uid).child($id).child('status').val() !== 'sending' && root.child('clothingKeeper').child('intakes').child(auth.uid).child($id).child('status').val() !== 'delivery_unknown'))",
      ".validate": "newData.hasChildren(['id','owner_id','address','description','category','status','analysis','created_at','updated_at','revision','events']) && newData.child('id').val() === $id && ((!data.exists() && newData.child('revision').val() === 1) || (data.exists() && newData.child('revision').val() === data.child('revision').val() + 1)) && newData.child('updated_at').val() === now && (!data.exists() || newData.child('owner_id').val() === data.child('owner_id').val())",
      "id": {
        ".validate": "newData.isString() && newData.val() === $id && newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/) && (!data.exists() || newData.val() === data.val())"
      },
      "owner_id": {
        ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || newData.val() === data.val())"
      },
      "address": {
        ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 200"
      },
      "description": {
        ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 1200"
      },
      "category": {
        ".validate": "newData.val() === 'overflow' || newData.val() === 'dumping' || newData.val() === 'damage' || newData.val() === 'no_label' || newData.val() === 'normal' || newData.val() === 'uncertain'"
      },
      "status": {
        ".validate": "newData.val() === 'reported' || newData.val() === 'submitted' || newData.val() === 'resolved'"
      },
      "latitude": {
        ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
      },
      "longitude": {
        ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
      },
      "analysis": {
        ".validate": "newData.val() === '직접 분류' || newData.val() === 'CLIP 제안 · 사용자 확인'"
      },
      "created_at": {
        ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() === data.val())"
      },
      "updated_at": {
        ".validate": "newData.isNumber() && newData.val() === now"
      },
      "revision": {
        ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
      },
      "events": {
        ".validate": "newData.hasChildren()",
        "$event": {
          ".validate": "newData.hasChildren(['id','status','kind','created_at'])",
          "id": {
            ".validate": "newData.isString() && newData.val() === $event && (!data.exists() || newData.val() === data.val())"
          },
          "status": {
            ".validate": "newData.val() === 'reported' || newData.val() === 'submitted' || newData.val() === 'resolved'"
          },
          "kind": {
            ".validate": "newData.val() === 'status' || newData.val() === 'content'"
          },
          "created_at": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      },
      "issues": {
        "overflow": {
          ".validate": "newData.isBoolean()"
        },
        "dumping": {
          ".validate": "newData.isBoolean()"
        },
        "damage": {
          ".validate": "newData.isBoolean()"
        },
        "no_label": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      },
      "bin_id": {
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
      },
      "photo_hash": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
      }
    }
  },
  "photos": {
    "$id": {
      ".read": "auth != null && root.child('clothingKeeper').child('reports').child($id).exists()",
      ".write": "auth != null && ((!data.exists() && newData.child('owner_id').val() === auth.uid) || data.child('owner_id').val() === auth.uid)",
      ".validate": "newData.hasChildren(['owner_id','data']) && newData.parent().parent().child('reports').child($id).child('owner_id').val() === auth.uid",
      "owner_id": {
        ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || newData.val() === data.val())"
      },
      "data": {
        ".validate": "newData.isString() && newData.val().length <= 400000 && newData.val().beginsWith('data:image/jpeg;base64,')"
      },
      "$other": {
        ".validate": false
      }
    }
  },
  "private": {
    "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      "$id": {
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('clothingKeeper').child('reports').child($id).child('owner_id').val() === auth.uid)",
        ".validate": "newData.hasChildren(['draft','agency','receipt_number','submitted_date','memo','revision','updated_at']) && ((!data.exists() && newData.child('revision').val() === 1) || (data.exists() && newData.child('revision').val() === data.child('revision').val() + 1)) && newData.child('updated_at').val() === now",
        "draft": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 12000"
        },
        "agency": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 100"
        },
        "receipt_number": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 100"
        },
        "submitted_date": {
          ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))"
        },
        "memo": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2000"
        },
        "revision": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
        },
        "updated_at": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  },
  "$other": {
    ".validate": false
  },
  "intakes": {
    ".read": "auth != null && auth.token.keeper_operator === true",
    "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      "$id": {
        ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.exists() && root.child('clothingKeeper').child('reports').child($id).child('owner_id').val() === auth.uid) || (!newData.exists() && data.child('status').val() !== 'queued' && data.child('status').val() !== 'sending' && data.child('status').val() !== 'delivery_unknown'))",
        ".validate": "newData.hasChildren(['report_id','owner_id','title','body','mode','consent','status','created_at','report_revision']) && newData.child('report_id').val() === $id && newData.child('owner_id').val() === $uid && newData.child('consent').val() === true && ((!data.exists() && newData.child('created_at').val() === now && newData.child('report_revision').val() === root.child('clothingKeeper').child('reports').child($id).child('revision').val() && ((newData.child('mode').val() === 'internal' && newData.child('status').val() === 'internal_received') || (newData.child('mode').val() === 'external' && newData.child('status').val() === 'queued' && root.child('clothingKeeper').child('integration').child('enabled').val() === true))) || data.exists())",
        "report_id": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "owner_id": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 200"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 12000"
        },
        "mode": {
          ".validate": "newData.val() === 'internal' || newData.val() === 'external'"
        },
        "consent": {
          ".validate": "newData.val() === true"
        },
        "status": {
          ".validate": "newData.val() === 'internal_received' || newData.val() === 'queued' || newData.val() === 'sending' || newData.val() === 'external_received' || newData.val() === 'delivery_unknown' || newData.val() === 'delivery_rejected'"
        },
        "created_at": {
          ".validate": "newData.isNumber()"
        },
        "report_revision": {
          ".validate": "newData.isNumber()"
        },
        "operator_notes": {
          "$note": {
            ".write": "auth != null && auth.token.keeper_operator === true && data.parent().parent().exists() && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['text','at','operator']) && newData.child('operator').val() === auth.uid && newData.child('at').val() === now",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 600"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "operator": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },
            "$other": {
              ".validate": false
            }
          },
          ".validate": "data.parent().exists() && auth.token.keeper_operator === true"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  },
  "integration": {
    ".read": "auth != null",
    ".write": false
  },
  "registry": {
    ".read": "auth != null",
    "$id": {
      ".write": "auth != null && auth.token.keeper_operator === true",
      ".validate": "newData.hasChildren(['address','latitude','longitude','source','checked'])",
      "address": {
        ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 200"
      },
      "latitude": {
        ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
      },
      "longitude": {
        ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
      },
      "source": {
        ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 1000"
      },
      "checked": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
      },
      "$other": {
        ".validate": false
      }
    }
  },
  "deliveryLedger": {
    ".read": false,
    ".write": false
  }
}
